# Copy to .env (git-ignored) and fill in. Variables already set in the environment win.
# Needed by `processing.build` / `processing.export_parquet` (dataset card, Kaggle metadata)
# and by `processing.publish`.
HF_REPO_ID=<hf-user>/meeting-notes-extractive-v1
KAGGLE_DATASET_ID=<kaggle-user>/meeting-notes-extractive-v1
SOURCE_REPO_URL=https://github.com/<github-user>/meeting-notes-extractive-corpus
